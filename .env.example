# Copia este archivo como .env y ajusta los valores (no subas el .env al repositorio).
FLASK_ENV=development
SECRET_KEY=cambia-esta-clave
# DATABASE_URL=postgresql://usuario:clave@host:5432/ransa   # por defecto: SQLite en data/ransa.db
DEMO_MODE=true                      # acceso de un clic por rol en el login (false en un despliegue real)
PUBLIC_ACCESS=true                  # enlace público: entra directo como Visitante (false en un despliegue real)
RISK_ALERT_THRESHOLD_PCT=80

# Integraciones opcionales (se activan solo si existen credenciales)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# WHATSAPP_BUSINESS_TOKEN=
# WHATSAPP_PHONE_ID=
# TEAMS_WEBHOOK_URL=
# SLACK_WEBHOOK_URL=
# OPENWEATHER_API_KEY=
# MAPBOX_TOKEN=
